<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the ASP.NET Core backend.

  The ASP.NET Core Module rewrites this file's handler section on publish, so
  the parts worth keeping here are the ones it does not touch: the request
  limits, the headers and the environment.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        In-process. Out-of-process adds a loopback hop to every request, and the
        only reason to prefer it is a hosting model this app does not use.
        stdout logging is off by default: it writes an unbounded file, and the
        application's own logging already goes where it is wanted. Turn it on
        only while diagnosing a startup failure.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Pixous.HrPortal.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!--
            26,214,400 bytes = 25 MB, matching
            spring.servlet.multipart.max-request-size. IIS refuses a larger body
            before the application sees it, so this and IISServerOptions have to
            agree or an upload fails with an IIS error page instead of the
            portal's own message.
          -->
          <requestLimits maxAllowedContentLength="26214400" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- IIS advertises itself by default; there is no reason to tell the
               internet which server and version is running. -->
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

      <!--
        WebSockets, for SignalR. Off by default in IIS, and without it the hub
        silently falls back to long polling: everything still works and the
        real-time features get slower and heavier, which is the hardest kind of
        problem to notice. The Windows feature has to be installed as well
        (Web-WebSockets); this only enables it for the site.
      -->
      <webSocket enabled="true" pingInterval="00:00:10" />
    </system.webServer>
  </location>
</configuration>
