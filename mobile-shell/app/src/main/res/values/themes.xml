<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The portal paints its own background and has its own header, so the app
      contributes no chrome of its own. The status bar takes the portal's
      indigo so the top of the screen does not read as a different app.
    -->
    <style name="Theme.Pixous" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#4F46E5</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
</resources>
