# Backend environment variables.
# Local dev reads sensible defaults from application.yml — you only need these
# in production (e.g. set them in the Render dashboard). Never commit real values.

# --- Database (external MySQL, e.g. Aiven) ---
# Easiest: set the full JDBC URL + credentials (Spring maps these automatically).
# SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/DBNAME?sslMode=REQUIRED&serverTimezone=Asia/Kolkata
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=your-db-password
#
# Alternatively (local docker-compose) the app builds the URL from these:
DB_HOST=mysql1002.site4now.net
DB_PORT=3306
DB_NAME=db_ab2fe4_ems
DB_USER=ab2fe4_ems
# Never a real password in this file — it is committed. Put the real one in .env,
# which is git-ignored. (The value that used to be here is in the repository's
# history and should be changed in the hosting control panel.)
DB_PASSWORD=
# Leave createDatabaseIfNotExist OUT for hosted MySQL: the account cannot create a
# database, and the connector asks it to on every connect.
DB_PARAMS=useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
# This account allows 20 connections in total, across everything using it.
DB_POOL_MAX=6
DB_POOL_MIN=1

# --- Security ---
# Base64/random string, at least 32 characters. On Render this is auto-generated.
APP_JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# --- CORS: the deployed frontend origin(s), comma-separated ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- Optional services (safe to leave unset) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# MAIL_HOST=localhost
# MAIL_PORT=1025

# --- Twilio SMS (off by default) ---
TWILIO_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_DEFAULT_CC=+91
