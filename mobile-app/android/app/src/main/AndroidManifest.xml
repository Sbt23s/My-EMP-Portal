<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app is useless without it, so it is declared rather than left to a
         plugin to pull in implicitly. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Punch-in and punch-out send GPS so the server can check the punch
         against the site's geofence. A punch with no coordinates is recorded as
         geofenceException=true, which is how every punch from this app was being
         filed before these were declared.

         Both, because Android grants them separately: a person may allow
         approximate location only, and COARSE alone is still worth having — a
         geofence radius is measured in tens of metres, so a coarse fix answers
         "are they at the site" correctly far more often than no fix at all.

         Deliberately NOT ACCESS_BACKGROUND_LOCATION. The app only reads a
         position while somebody is looking at the punch button; asking to
         follow them when it is closed would be a different product, and Play
         Store review treats it as one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- The selfie for a face-verified punch.
         Declared, but the photo is taken through the system camera app, which
         holds the permission itself — so most devices never prompt for this.
         It is here because some OEM camera apps hand the request back to the
         calling app, and on those the capture silently returns nothing without
         it. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Android 13 and later require this before a notification can be shown at
         all. Without it the app raises them and nothing appears — no error, no
         log line, just silence. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Voice and video calls.
         MODIFY_AUDIO_SETTINGS is what lets the speakerphone toggle work; without
         it the call plays through the earpiece whatever the button says. The
         Bluetooth one is for a headset — a call that ignores the headset someone
         is wearing reads as the call being broken. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- A phone with no camera can still do everything else, so this must not
         keep the app out of the Play Store listing for such a device. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <application
        android:label="Pixous HR"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
