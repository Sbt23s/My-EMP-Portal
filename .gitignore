.env.*
!.env.example
!.env.production.example
!**/.env.example
!**/.env.production.example
# web/.env.production holds no secrets: two empty/relative values that keep a
# production build pointing at its own origin. Ignored, it protected only the
# machine it was written on, and a fresh clone would rebuild with the developer
# .env baked in -- which is how localhost:7060 reached production and broke
# login for everyone.
!web/.env.production

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# Runtime storage (generated PDFs, QR codes, uploads)
backend/storage/

# Python (analytics-service)
__pycache__/
*.py[cod]
.venv/
venv/

# Generated face embeddings (enrolled at runtime, not source)
analytics-service/faces/*.npy

# Two empty files created by mistyped shell commands. Left on disk rather
# than deleted, but they are not part of the project.
backend/\[Help
backend/localStorage.removeItem(k))

